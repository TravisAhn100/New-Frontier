{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "new-frontier",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "new-frontier-editorial",
      "database_id": "da438633-09df-4cee-b376-721dd2ae51a9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTICLE_IMAGES",
      "bucket_name": "new-frontier-article-images"
    }
  ],
  "vars": {
    "EDITORIAL_SESSION_TTL_SECONDS": "28800"
  }
}
